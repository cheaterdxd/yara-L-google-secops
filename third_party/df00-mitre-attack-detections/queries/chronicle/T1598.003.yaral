# T1598.003 — Spearphishing Link
# Tactic: Reconnaissance
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 detection rule for Spearphishing Link (T1598.003).
# Data Sources: Google Chronicle SIEM, Chronicle UDM
# Required Sources: USER_LOGIN, USER_RESOURCE_ACCESS
# False Positives: Marketing emails from legitimate vendors using URL shorteners (bit.ly, ow.ly) and click-tracking redirectors for engagement analytics, Internal security awareness training phishing simulations from platforms such as KnowBe4, Proofpoint Security Awareness Training, or Cofense, Legitimate SaaS vendor password reset or onboarding emails containing 'login', 'verify', or 'account' keywords in URLs, Corporate newsletter or HR communication services using URL redirection for open and click tracking
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1598.003
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1598_003_spearphishing_link {
  meta:
    author = "df00tech"
    description = "Detects Spearphishing Link (T1598.003)"
    mitre_attack_tactic = "TA0043"
    mitre_attack_technique = "T1598.003"
    confidence = "medium"
    severity = "high"
  events:
    $e.metadata.event_type = "USER_LOGIN"
    $e.principal.user.userid != ""
  condition:
    $e
}
