# T1568 — Dynamic Resolution
# Tactic: Command and Control
# Platform: Google Chronicle (YARA-L)
#
# Description: Chronicle YARA-L rule detecting DNS queries to DDNS providers commonly used for C2 dynamic resolution.
# Data Sources: DNS Events via Chronicle UDM
# Required Sources: NETWORK_DNS
# False Positives: Developers or system administrators accessing personal DDNS-registered home lab or remote access infrastructure (common with No-IP or DuckDNS for self-hosted services), Remote access tools such as TeamViewer, AnyDesk, or VNC clients that use DDNS to locate remote endpoints when the user has configured a DDNS address for their home machine, IoT management software, IP camera viewers, or NVR clients that connect to consumer DDNS services to locate home surveillance equipment, Network monitoring agents or IT automation tools that use DDNS-hosted endpoints for health check callbacks or configuration retrieval
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1568
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule ddns_c2_resolution {
  meta:
    author = "Detection Engineering"
    description = "Detects DNS resolution of DDNS providers used for C2 (T1568)"
    severity = "HIGH"
    tactic = "TA0011"

  events:
    $e.metadata.event_type = "NETWORK_DNS"
    re.regex($e.network.dns.questions.name, `(?i)\.(no-ip\.com|noip\.com|dyndns\.(org|com)|duckdns\.org|changeip\.com|afraid\.org|dynv6\.com|hopto\.org|ddns\.net|zapto\.org|sytes\.net|redirectme\.net)$`) nocase

  condition:
    $e
}
