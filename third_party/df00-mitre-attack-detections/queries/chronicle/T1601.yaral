# T1601 — Modify System Image
# Tactic: Defense Evasion
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for T1601 detection using UDM event types and field matching.
# Data Sources: Cisco IOS Syslog, Juniper JunOS Syslog
# Required Sources: NETWORK_UNCATEGORIZED
# False Positives: Authorized network engineers performing scheduled firmware upgrades during maintenance windows via TFTP/SCP, Network management platforms (Cisco Prime, SolarWinds, Ansible AWX) performing automated image distribution and version compliance enforcement, Legitimate disaster recovery operations restoring a known-good baseline image after hardware failure, Vendor-assisted software update procedures conducted by authorized third-party contractors with change tickets
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1601
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detect_system_image_modification {
  meta:
    author = "Argus"
    description = "Detects network device OS image modification attempts"
    severity = "CRITICAL"
    technique = "T1601"
  events:
    $e.metadata.event_type = "NETWORK_UNCATEGORIZED"
    $e.metadata.product_name = "Cisco IOS"
    (
      re.regex($e.network.session_id, `copy (tftp|ftp|scp)|boot system flash|install activate|INTEGRITY_FAILED|SIGNATURE_FAILED|FLASH-5-SIGNIFICANT_FLASH`) nocase
    )
  condition:
    $e
}
