# T1591 — Gather Victim Org Information
# Tactic: Reconnaissance
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 detection rule for Gather Victim Org Information (T1591).
# Data Sources: Google Chronicle SIEM, Chronicle UDM
# Required Sources: NETWORK_HTTP, NETWORK_CONNECTION
# False Positives: IT automation scripts running bulk user provisioning or deprovisioning workflows, HR system sync tools (Workday, BambooHR) performing scheduled directory synchronization, Security tools such as Microsoft Entra ID Governance performing access reviews, PowerShell scripts run by directory administrators for legitimate reporting
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1591
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1591_gather_victim_org_information {
  meta:
    author = "df00tech"
    description = "Detects bulk Azure AD org enumeration via Microsoft Graph API"
    mitre_attack_tactic = "TA0043"
    mitre_attack_technique = "T1591"
    confidence = "medium"
    severity = "high"
  events:
    $e.metadata.event_type = "USER_RESOURCE_ACCESS"
    $e.metadata.product_name = "Azure Active Directory"
    $e.target.resource.name = /Get users|List users|Get groups|List groups|Get members|Get organization|Get directoryRoles/
    $e.security_result.action = "ALLOW"
  match:
    $e.principal.user.userid over 1h
  condition:
    #e > 30
}
