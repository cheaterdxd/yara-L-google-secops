# T1666 — Modify Cloud Resource Hierarchy
# Tactic: Defense Evasion
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for detecting Modify Cloud Resource Hierarchy (T1666).
# Data Sources: Azure AD, Microsoft 365
# Required Sources: USER_CHANGE, RESOURCE_CREATION
# False Positives: Legitimate cloud governance teams reorganizing subscriptions into new management groups as part of planned landing zone migrations, Authorized finance or billing administrators transferring pay-as-you-go subscriptions between company-owned tenants during corporate restructuring, DevOps teams creating new Azure subscriptions for new product environments under an approved enterprise agreement
# Confidence: high  Severity: critical
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1666
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detection_t1666 {
  meta:
    author = "Argus Detection Platform"
    description = "Detects Modify Cloud Resource Hierarchy cloud activity - T1666"
    severity = "HIGH"
    mitre_attack = "T1666"
    reference = "https://attack.mitre.org/techniques/T1666/"

  events:
    $e.metadata.event_type = "USER_CHANGE"
    $e.principal.user.userid = $user
    $e.principal.ip = $source_ip
    $e.target.resource.name = $resource
    (
      re.regex($e.metadata.product_event_type, `(?i)(add|delete|consent|update|create)`) and
      not re.regex($e.principal.user.userid, `(?i)(service-|automation-|pipeline-)`)
    )

  condition:
    $e
}
