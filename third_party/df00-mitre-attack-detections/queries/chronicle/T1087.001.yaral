# T1087.001 — Local Account
# Tactic: Discovery
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule detecting T1087.001 local account enumeration.
# Data Sources: Google Chronicle SIEM, Google Chronicle Unified Data Model (UDM), Windows EDR and Sysmon telemetry forwarded to Chronicle
# Required Sources: UDM Events (PROCESS_LAUNCH)
# False Positives: Authorized privileged account audits run by IT administrators via net.exe or PowerShell management scripts under sanctioned change windows, Service accounts used by SCCM, Microsoft Intune, or Group Policy processing that query local group membership during policy application cycles, Corporate security tooling performing periodic CIS benchmark compliance checks that enumerate local administrators group members across endpoints
# Confidence: high  Severity: medium
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1087.001
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1087_001_local_account_enumeration {
  meta:
    author = "Detection Engineering"
    description = "Detects local account enumeration via net.exe, PowerShell Get-Local* cmdlets, WMIC Win32_UserAccount, or query.exe"
    mitre_attack_tactic = "Discovery"
    mitre_attack_technique = "T1087.001"
    severity = "MEDIUM"
    priority = "MEDIUM"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    (
      (
        re.regex($e.principal.process.file.full_path, `(?i)net(1)?\.exe$`) and
        re.regex($e.principal.process.command_line, `(?i)(user|localgroup|accounts)`)
      ) or
      (
        re.regex($e.principal.process.file.full_path, `(?i)powershell\.exe$`) and
        re.regex($e.principal.process.command_line, `(?i)(Get-LocalUser|Get-LocalGroup|Get-LocalGroupMember|Win32_UserAccount|Win32_UserProfile)`)
      ) or
      (
        re.regex($e.principal.process.file.full_path, `(?i)wmic\.exe$`) and
        re.regex($e.principal.process.command_line, `(?i)(useraccount|win32_useraccount)`)
      ) or
      (
        re.regex($e.principal.process.file.full_path, `(?i)query\.exe$`) and
        re.regex($e.principal.process.command_line, `(?i)\b(user|session)\b`)
      )
    )

  condition:
    $e
}
