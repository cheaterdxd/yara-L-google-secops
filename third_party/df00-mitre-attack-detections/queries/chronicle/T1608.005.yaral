# T1608.005 — Link Target
# Tactic: Resource Development
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for T1608.005 detection using UDM event types and field matching.
# Data Sources: Endpoint Telemetry, Web Proxy, Google Workspace
# Required Sources: NETWORK_HTTP, PROCESS_LAUNCH, FILE_CREATION
# False Positives: Legitimate marketing emails using URL shorteners (bit.ly, ow.ly) for campaign tracking — common in newsletters and vendor communications, Internal developer tools and previews legitimately hosted on Netlify, Vercel, or Azure App Services — especially from known SaaS vendors or IT teams, Security awareness training platforms (KnowBe4, Proofpoint Security Awareness) that intentionally send simulated phishing links through URL shorteners, IPFS-hosted decentralized applications (dApps), NFT metadata, or legitimate Web3 projects linked in business communications, SaaS vendor onboarding emails with redirect links through PaaS infrastructure as part of legitimate SSO flows
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1608.005
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detect_stage_capabilities {
  meta:
    author = "Argus"
    description = "Detects staging of capabilities from external infrastructure"
    severity = "HIGH"
    technique = "T1608"
  events:
    $e.metadata.event_type = "NETWORK_HTTP"
    (
      re.regex($e.target.url, `\.(exe|dll|bin|ps1|bat|vbs|hta|sh|elf)($|\?)`) nocase or
      re.regex($e.target.hostname, `transfer\.sh|paste\.ee|gofile\.io|anonfiles|temp\.sh`) nocase
    )
    $e.principal.process.file.full_path != ""
  condition:
    $e
}
