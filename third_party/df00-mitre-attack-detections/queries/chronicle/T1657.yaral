# T1657 — Financial Theft
# Tactic: Impact
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for detecting Financial Theft (T1657).
# Data Sources: EDR Platform
# Required Sources: PROCESS_LAUNCH
# False Positives: Legitimate cryptocurrency portfolio management tools (CryptoCompare, Koinly, CoinTracking) reading wallet files for tax/portfolio reporting, IT backup software (Veeam, Acronis, Windows Backup) scanning AppData directories including wallet application folders, Finance team members creating legitimate email forwarding rules for invoice or payment notification workflows
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1657
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detection_t1657 {
  meta:
    author = "Argus Detection Platform"
    description = "Detects Financial Theft - T1657"
    severity = "HIGH"
    mitre_attack = "T1657"
    reference = "https://attack.mitre.org/techniques/T1657/"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.principal.hostname = $hostname
    $e.target.process.file.full_path = $process_path
    $e.target.process.command_line = $cmdline
    re.regex($e.target.process.file.full_path, `(?i)(powershell|cmd|wscript|cscript)\.exe$`) and
    re.regex($e.target.process.command_line, `(?i)(-enc|-bypass|invoke-expression)`)
    not re.regex($e.principal.process.file.full_path, `(?i)(trustedinstaller|msiexec)`)

  condition:
    $e
}
