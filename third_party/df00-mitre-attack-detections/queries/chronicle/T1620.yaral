# T1620 — Reflective Code Loading
# Tactic: Defense Evasion
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for T1620 detection using UDM event types and field matching.
# Data Sources: Endpoint Telemetry
# Required Sources: PROCESS_LAUNCH
# False Positives: Legitimate .NET applications and developer tooling that use Assembly.Load() or Reflection.Assembly for plugin systems (e.g., Visual Studio extensions, Roslyn compilers), Security tooling and EDR agents that use reflective loading for their own module injection (e.g., CrowdStrike Falcon sensor, Carbon Black), PowerShell modules that use Add-Type or Assembly.Load to compile and load inline C# at runtime for legitimate administrative tasks (e.g., ActiveDirectory management scripts)
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1620
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detect_reflective_code_loading {
  meta:
    author = "Argus"
    description = "Detects reflective code loading via Assembly.Load and similar techniques"
    severity = "HIGH"
    technique = "T1620"
  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    (
      re.regex($e.target.process.command_line, `Assembly\.Load|\[Reflection\.Assembly\]|loadfrom|\[Runtime\.InteropServices\.Marshal\]`) nocase or
      (re.regex($e.target.process.file.full_path, `msbuild\.exe|regsvcs\.exe|regasm\.exe|installutil\.exe`) nocase and
       re.regex($e.target.process.command_line, `\.dll$|\.cs$`) nocase)
    )
  condition:
    $e
}
