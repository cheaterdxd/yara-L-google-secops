# THREAT-M365-PasswordSpray — Microsoft 365 Password Spray Attack Detection
# Tactic: Credential Access
# Platform: Google Chronicle (YARA-L)
#
# Description: Chronicle YARA-L 2.0 rule detecting password spray against Microsoft 365 by aggregating authentication failures per source IP in 30-minute windows.
# Data Sources: Google Chronicle Azure AD ingestion
# Required Sources: UDM Events (USER_LOGIN)
# False Positives: NAT environments, Misconfigured service accounts
# Confidence: high  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/THREAT-M365-PasswordSpray
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule m365_password_spray_t1110_003 {
  meta:
    author = "Argus Detection Engineering"
    description = "Detects M365/Entra ID password spray: 20+ auth failures targeting 10+ unique accounts from the same source IP within 30 minutes"
    mitre_attack_technique = "T1110.003"
    severity = "HIGH"
    confidence = "HIGH"

  events:
    $e.metadata.event_type = "USER_LOGIN"
    $e.security_result.action = "FAIL"
    $e.metadata.product_name = "Azure AD"
    $e.principal.ip = $src_ip
    $e.target.user.email_addresses[0] = $user

  match:
    $src_ip over 30m

  condition:
    #e >= 20 and #user >= 10
}
