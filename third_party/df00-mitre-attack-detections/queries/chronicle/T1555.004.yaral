# T1555.004 — Windows Credential Manager
# Tactic: Credential Access
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule detecting Windows Credential Manager access using UDM PROCESS_LAUNCH events.
# Data Sources: Google Chronicle UDM, Chronicle Forwarder (Windows Event Logs), Chronicle Sysmon Ingestion Pipeline
# Required Sources: UDM PROCESS_LAUNCH events
# False Positives: Automated IT compliance scripts enumerating stored credentials for audit purposes using vaultcmd or cmdkey on a scheduled basis, Password migration tooling leveraging keymgr.dll or CredEnumerate APIs to export and transfer credentials during workstation replacement projects, Security operations teams executing Mimikatz in isolated sandbox or malware analysis lab environments for threat research or training exercises
# Confidence: high  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1555.004
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1555_004_windows_credential_manager_access {
  meta:
    author = "Detection Engineering"
    description = "Detects Windows Credential Manager enumeration and harvesting via vaultcmd.exe, cmdkey.exe, rundll32.exe keymgr.dll, Mimikatz vault/dpapi modules, and PowerShell credential dump tools"
    mitre_attack_tactic = "Credential Access"
    mitre_attack_technique = "T1555.004"
    severity = "HIGH"
    confidence = "HIGH"
    platforms = "Windows"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.principal.hostname = $hostname
    (
      (
        re.regex($e.target.process.file.full_path, `(?i)vaultcmd[.]exe$`) and
        re.regex($e.target.process.command_line, `(?i)/(listcreds|list)`)
      ) or
      (
        re.regex($e.target.process.file.full_path, `(?i)cmdkey[.]exe$`) and
        re.regex($e.target.process.command_line, `(?i)/list`)
      ) or
      (
        re.regex($e.target.process.file.full_path, `(?i)rundll32[.]exe$`) and
        re.regex($e.target.process.command_line, `(?i)keymgr[.]dll`)
      ) or
      re.regex($e.target.process.command_line, `(?i)(Invoke-WCMDump|vault::cred|vault::list|dpapi::cred|Get-VaultCredential|CredEnumerateA|CredEnumerateW|KRShowKeyMgr)`)
    )

  condition:
    $e
}
