# T1681 — Search Threat Vendor Data
# Tactic: Reconnaissance
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for detecting Search Threat Vendor Data (T1681).
# Data Sources: EDR Platform
# Required Sources: PROCESS_LAUNCH
# False Positives: Security Operations Center analysts performing daily threat hunting or indicator enrichment via threat intel APIs, Automated SOAR playbooks or SIEM enrichment workflows querying VirusTotal or similar platforms to enrich alerts, Vulnerability management or penetration testing tools performing infrastructure fingerprinting via Shodan
# Confidence: low  Severity: medium
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1681
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detection_t1681 {
  meta:
    author = "Argus Detection Platform"
    description = "Detects Search Threat Vendor Data - T1681"
    severity = "HIGH"
    mitre_attack = "T1681"
    reference = "https://attack.mitre.org/techniques/T1681/"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.principal.hostname = $hostname
    $e.target.process.file.full_path = $process_path
    $e.target.process.command_line = $cmdline
    re.regex($e.target.process.file.full_path, `(?i)(powershell|cmd|wscript|cscript)\.exe$`) and
    re.regex($e.target.process.command_line, `(?i)(-enc|-bypass|invoke-expression)`)
    not re.regex($e.principal.process.file.full_path, `(?i)(trustedinstaller|msiexec)`)

  condition:
    $e
}
