# T1567.003 — Exfiltration to Text Storage Sites
# Tactic: Exfiltration
# Platform: Google Chronicle (YARA-L)
#
# Description: Chronicle YARA-L rule detecting data exfiltration to paste sites and code repositories.
# Data Sources: Network Events via Chronicle UDM
# Required Sources: NETWORK_CONNECTION
# False Positives: Developers legitimately sharing code snippets or debug output to pastebin/hastebin during normal work, CI/CD pipelines or build scripts that publish logs or artifacts to paste sites for sharing build results, Security researchers or incident responders sharing sanitized IOCs or analysis outputs via paste sites, IT support staff using paste sites to share configuration examples or troubleshooting commands with users, Automated testing tools that upload test results to hastebin or similar for review
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1567.003
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule paste_site_exfiltration {
  meta:
    author = "Detection Engineering"
    description = "Detects data exfiltration to paste sites and code repos (T1567.003)"
    severity = "HIGH"
    tactic = "TA0010"

  events:
    $e.metadata.event_type = "NETWORK_CONNECTION"
    $e.network.direction = "OUTBOUND"
    re.regex($e.target.hostname, `(?i)(pastebin\.com|hastebin\.com|ghostbin|paste\.ee|dpaste|sprunge\.us|ix\.io|termbin|controlc\.com|gist\.github\.com)`) nocase
    $e.network.sent_bytes > 102400

  condition:
    $e
}
