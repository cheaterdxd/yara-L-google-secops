# T1027.015 — Compression
# Tactic: Defense Evasion
# Platform: Google Chronicle (YARA-L)
#
# Description: Chronicle YARA-L rule that triggers on compression utility execution where the parent process is a known Office application or scripting host, or where command-line flags indicate self-extracting archives, encryption, or staging in high-risk directories.
# Data Sources: Chronicle SIEM, Google Workspace, Windows Event Forwarding
# Required Sources: udm.events
# False Positives: Office-triggered automation for legitimate file packaging and distribution, IT operations using self-extracting archives for software deployment, Authorized red team exercises simulating payload delivery chains
# Confidence: medium  Severity: medium
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1027.015
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1027_015_compression_suspicious {
  meta:
    author = "argus-v1"
    description = "Detects compression tools spawned by Office, scripting hosts, or with SFX/encryption flags"
    severity = "MEDIUM"
    technique = "T1027.015"
    tactic = "TA0005"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.target.process.file.full_path = /(?i)(7z\.exe|7za\.exe|7zr\.exe|winrar\.exe|rar\.exe|unrar\.exe|winzip32\.exe|winzip64\.exe|pkzip\.exe|wzzip\.exe)$/
    (
      $e.principal.process.file.full_path = /(?i)(winword|excel|powerpnt|outlook|mshta|wscript|cscript|rundll32|regsvr32|msiexec)\.exe$/
      or
      $e.target.process.command_line = /(?i)(-sfx|-mhe|-mx9|-p[a-zA-Z0-9]{1,}|-ao)/
      or
      $e.target.process.command_line = /(?i)(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\)/
    )

  condition:
    $e
}
