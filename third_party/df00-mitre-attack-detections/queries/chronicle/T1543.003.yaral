# T1543.003 — Windows Service
# Tactic: Persistence, Privilege Escalation
# Platform: Google Chronicle (YARA-L)
#
# Description: Chronicle YARA-L rule detecting Windows service creation with suspicious binary paths or interpreter usage.
# Data Sources: Windows Service Events via Chronicle UDM
# Required Sources: SERVICE_CREATION
# False Positives: Software installers legitimately creating new services during application installation (MSI packages, third-party software), System administrators manually creating or reconfiguring services for maintenance or troubleshooting using sc.exe, Configuration management tools (SCCM, Chef, Puppet, Ansible) modifying service configurations as part of desired state enforcement, Endpoint security products and monitoring agents installing their own services during deployment, Windows Update and TrustedInstaller modifying existing service ImagePath values during OS updates
# Confidence: high  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1543.003
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule windows_service_persistence {
  meta:
    author = "Detection Engineering"
    description = "Detects Windows service creation with suspicious binary paths (T1543.003)"
    severity = "HIGH"
    tactic = "TA0003"

  events:
    $e.metadata.event_type = "SERVICE_CREATION"
    (
      re.regex($e.target.registry.registry_value_data, `(?i)(\\Temp\\|\\AppData\\|\\ProgramData\\|\\Users\\Public\\|cmd\.exe|powershell\.exe)`) nocase or
      re.regex($e.target.process.command_line, `(?i)(\\Temp\\|\\AppData\\|cmd\.exe|powershell\.exe)`) nocase
    )

  condition:
    $e
}
