# T1608 — Stage Capabilities
# Tactic: Resource Development
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 rule for T1608 detection using UDM event types and field matching.
# Data Sources: Endpoint Telemetry, Web Proxy, Google Workspace
# Required Sources: NETWORK_HTTP, PROCESS_LAUNCH, FILE_CREATION
# False Positives: Developers legitimately downloading build artifacts, scripts, or tools from GitHub raw content or cloud storage during CI/CD workflows, IT administrators using certutil or curl to download approved software packages from cloud storage buckets, Security researchers or red teamers running authorized testing from internal systems that happen to pull tools from public staging platforms, Automated deployment pipelines or configuration management tools (Ansible, Chef, Puppet) that fetch scripts from blob storage
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1608
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule detect_stage_capabilities {
  meta:
    author = "Argus"
    description = "Detects staging of capabilities from external infrastructure"
    severity = "HIGH"
    technique = "T1608"
  events:
    $e.metadata.event_type = "NETWORK_HTTP"
    (
      re.regex($e.target.url, `\.(exe|dll|bin|ps1|bat|vbs|hta|sh|elf)($|\?)`) nocase or
      re.regex($e.target.hostname, `transfer\.sh|paste\.ee|gofile\.io|anonfiles|temp\.sh`) nocase
    )
    $e.principal.process.file.full_path != ""
  condition:
    $e
}
