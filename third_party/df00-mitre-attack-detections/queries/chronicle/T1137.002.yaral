# T1137.002 — Office Test
# Tactic: Persistence
# Platform: Google Chronicle (YARA-L)
#
# Description: YARA-L rule detecting Office Test registry key creation or modification in Google Chronicle UDM.
# Data Sources: Windows Registry Events via Chronicle UDM
# Required Sources: REGISTRY_MODIFICATION
# False Positives: Microsoft internal developers using Office Test key for legitimate testing (extremely rare in production environments), Security researchers or red teamers running controlled tests on isolated systems, Unusual corporate Office customization tools that happen to use this registry path (very uncommon)
# Confidence: high  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1137.002
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule office_test_registry_persistence {
  meta:
    author = "Detection Engineering"
    description = "Detects Office Test registry key persistence (T1137.002)"
    severity = "HIGH"
    tactic = "TA0003"

  events:
    $e.metadata.event_type = "REGISTRY_MODIFICATION"
    re.regex($e.target.registry.registry_key, `(?i)Microsoft\\Office test`) nocase

  condition:
    $e
}
