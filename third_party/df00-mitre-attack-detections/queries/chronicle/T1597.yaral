# T1597 — Search Closed Sources
# Tactic: Reconnaissance
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 detection rule for Search Closed Sources (T1597).
# Data Sources: Google Chronicle SIEM, Chronicle UDM
# Required Sources: NETWORK_CONNECTION, NETWORK_FLOW
# False Positives: Sales and marketing teams legitimately using ZoomInfo, Apollo.io, or CrunchBase for lead generation and prospecting, HR and recruiting professionals using Clearbit, RocketReach, or Lusha to source candidates, Security researchers or threat intelligence analysts accessing dark web proxy services as part of authorized threat hunting, Automated CI/CD pipelines or marketing automation tools that enrich contact data via data broker APIs
# Confidence: low  Severity: medium
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1597
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1597_search_closed_sources {
  meta:
    author = "df00tech"
    description = "Detects Search Closed Sources (T1597)"
    mitre_attack_tactic = "TA0043"
    mitre_attack_technique = "T1597"
    confidence = "low"
    severity = "medium"
  events:
    $e.metadata.event_type = "NETWORK_CONNECTION"
    $e.principal.ip != ""
  condition:
    $e
}
