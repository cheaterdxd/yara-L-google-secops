# T1599.001 — Network Address Translation Traversal
# Tactic: Defense Evasion
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 detection rule for Network Address Translation Traversal (T1599.001).
# Data Sources: Google Chronicle SIEM, Chronicle UDM
# Required Sources: NETWORK_CONNECTION, NETWORK_FLOW
# False Positives: Authorized network engineers making planned NAT changes during approved change management windows — correlate against change tickets before escalating, Automated configuration management tools (Ansible, Terraform, Cisco DNA Center, NetBox) applying approved network configurations on a scheduled basis, Cloud infrastructure automation scripts creating or modifying Azure NAT Gateways as part of normal CI/CD deployment pipelines, Network device reboots restoring previously configured NAT rules that trigger repeated SYS-5-CONFIG_I log events from startup config application
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1599.001
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule t1599_001_network_address_translation_tr {
  meta:
    author = "df00tech"
    description = "Detects Network Address Translation Traversal (T1599.001)"
    mitre_attack_tactic = "TA0043"
    mitre_attack_technique = "T1599.001"
    confidence = "medium"
    severity = "high"
  events:
    $e.metadata.event_type = "NETWORK_CONNECTION"
    $e.principal.ip != ""
  condition:
    $e
}
