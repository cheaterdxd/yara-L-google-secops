# T1580 — Cloud Infrastructure Discovery
# Tactic: Discovery
# Platform: Google Chronicle (YARA-L)
#
# Description: Google Chronicle YARA-L 2.0 detection for Cloud Infrastructure Discovery.
# Data Sources: Google Chronicle SIEM, Cloud audit logs (Azure/AWS)
# Required Sources: USER_RESOURCE_ACCESS
# False Positives: Cloud management platforms performing authorized scheduled resource inventories, Infrastructure-as-code tools enumerating cloud state for reconciliation, Security compliance scanners performing authorized cloud posture assessments, Automated cost optimization tools enumerating cloud resources
# Confidence: medium  Severity: high
#
# Full detection (all 7 SIEMs, playbooks, atomic tests): https://df00tech.com/detections/T1580
# License: MIT — https://github.com/df00tech/mitre-attack-detections

rule T1580_cloud_infra_modification {
  meta:
    author = "Detection Engineering"
    description = "Detects suspicious cloud infrastructure modifications"
    severity = "high"
    confidence = "medium"
    mitre_attack = "T1580"
    reference = "https://attack.mitre.org/techniques/T1580/"

  events:
    $e.metadata.event_type = "USER_RESOURCE_ACCESS"
    re.regex($e.metadata.product_event_type, `(?i)(snapshot|virtualMachine|instance|compute|create|delete|modify)`)
    not re.regex($e.principal.user.email_addresses, `(?i)(backup|automation|serviceaccount)`)

  condition:
    $e
}
