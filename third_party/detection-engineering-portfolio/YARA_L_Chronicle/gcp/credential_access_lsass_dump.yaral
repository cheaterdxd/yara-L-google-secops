rule CredentialAccess_LsassMemoryDump {
  meta:
    author = "aloc999"
    description = "Detects LSASS memory dump attempts via various Windows utilities"
    mitre_technique = "T1003.001"
    severity = "CRITICAL"
    platform = "Windows"
    log_source = "WINDOWS_PROCESS_CREATION"
    version = "1.0"
    created = "2026-01-15"
    modified = "2026-07-20"
    false_positive_notes = "Legitimate debugging, EDR/AV solutions"

  events:
    $process.metadata.event_type = "PROCESS_LAUNCH"
    $process.target.process.file.full_path nocase "rundll32.exe"
    $process.target.process.command_line nocase "comsvcs.dll"
    $process.target.process.command_line nocase "MiniDump"

  condition:
    $process

  outcome:
    $risk_score = max(95)
}

rule CredentialAccess_Kerberoasting {
  meta:
    author = "aloc999"
    description = "Detects Kerberoasting SPN scan activity via Kerberos TGS-REQ"
    mitre_technique = "T1558.003"
    severity = "HIGH"
    platform = "Windows"
    log_source = "WINDOWS_KERBEROS_TICKET"
    version = "1.0"
    created = "2026-03-05"
    modified = "2026-07-15"
    false_positive_notes = "Legitimate service account usage, monitoring tools"

  events:
    $ticket.metadata.event_type = "NETWORK_CONNECTION"
    $ticket.network.application_protocol = "KERBEROS"

  condition:
    $ticket

  outcome:
    $risk_score = max(75)
}